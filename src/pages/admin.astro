      function getFallbackHorses(): HorseRecord[] {
        return INITIAL_HORSES.map((h, i) => ({
          ...h,
          id: `horse-auto-${i + 1}`,
          created_at: new Date().toISOString(),
        })) as HorseRecord[];
      }

      async function loadHorsesData() {
        let loadedHorses: HorseRecord[] = [];
        const local = localStorage.getItem('almas_horses');
        const localHorses: HorseRecord[] = local ? JSON.parse(local) : [];

        if (isLiveDb && supabase) {
          try {
            const { data, error } = await supabase
              .from('caballos')
              .select('*')
              .order('created_at', { ascending: true });

            if (error) {
              console.warn('Tabla caballos no creada aún o con error en Supabase:', error.message);
              loadedHorses = localHorses.length > 0 ? localHorses : getFallbackHorses();
            } else if (data && data.length > 0) {
              loadedHorses = data;
              // Si en local había caballos con fotos editadas o datos que en Supabase tienen placeholder, preservamos los cambios del usuario
              if (localHorses.length > 0) {
                loadedHorses = loadedHorses.map((h) => {
                  const match = localHorses.find(
                    (lh) => lh.id === h.id || (lh.nombre && h.nombre && lh.nombre.toLowerCase().trim() === h.nombre.toLowerCase().trim())
                  );
                  if (match) {
                    const hasBetterPhoto = match.foto && !match.foto.includes('placeholders') && (!h.foto || h.foto.includes('placeholders'));
                    return {
                      ...h,
                      foto: hasBetterPhoto ? match.foto : h.foto,
                      descripcion: h.descripcion || match.descripcion,
                      manada_id: h.manada_id || match.manada_id,
                      manada_nombre: h.manada_nombre || match.manada_nombre,
                    };
                  }
                  return h;
                });
              }
            } else {
              // Supabase está vacío: sembrar con datos locales si existen o con INITIAL_HORSES
              const toInsert = localHorses.length > 0
                ? localHorses.map(({ id, created_at, ...rest }) => rest)
                : INITIAL_HORSES;

              try {
                const { data: seeded, error: seedError } = await supabase
                  .from('caballos')
                  .insert(toInsert as any)
                  .select();
                if (!seedError && seeded && seeded.length > 0) {
                  loadedHorses = seeded;
                } else {
                  loadedHorses = localHorses.length > 0 ? localHorses : getFallbackHorses();
                }
              } catch {
                loadedHorses = localHorses.length > 0 ? localHorses : getFallbackHorses();
              }
            }
          } catch (err) {
            console.warn('Error cargando caballos de Supabase:', err);
            loadedHorses = localHorses.length > 0 ? localHorses : getFallbackHorses();
          }
        } else {
          loadedHorses = localHorses.length > 0 ? localHorses : getFallbackHorses();
        }

        horsesList = loadedHorses;
        saveLocalHorses();

        updateHorseSelectDropdowns();
        renderManadasBoard();
        renderHorsesGrid();
        updateBadges();
      }

      function saveLocalHorses() {
        localStorage.setItem('almas_horses', JSON.stringify(horsesList));
      }

      function updateHorseSelectDropdowns() {
        // Dropdown en el filtro de la tabla de padrinos (Ordenado A-Z)
        const sortedHorses = [...horsesList].sort((a, b) =>
          a.nombre.localeCompare(b.nombre, 'es', { sensitivity: 'base' })
        );

        const currentSelectedFilter = filterHorse.value;
        filterHorse.innerHTML = '<option value="all">Todos los caballos</option>';
        sortedHorses.forEach((h) => {
          const opt = document.createElement('option');
          opt.value = h.id;
          opt.textContent = `${h.nombre}`;
          filterHorse.appendChild(opt);
        });
        filterHorse.value = currentSelectedFilter || 'all';

        totalHorsesBadge.textContent = String(horsesList.length);
      }

      function renderHorsesGrid() {
        const query = (searchHorsesInput.value || '').toLowerCase().trim();
        const status = filterHorseStatus.value;
        const selectedManada = filterHorseManadaSelect.value;

        const filtered = horsesList.filter((h) => {
          const matchesQuery =
            h.nombre.toLowerCase().includes(query) ||
            (h.descripcion && h.descripcion.toLowerCase().includes(query));
          const matchesStatus = status === 'all' || h.estado === status;
          const matchesManada =
            selectedManada === 'all'
              ? true
              : selectedManada === 'none'
                ? !h.manada_id
                : h.manada_id === selectedManada;

          return matchesQuery && matchesStatus && matchesManada;
        });

        if (filtered.length === 0) {
          horsesGridContainer.innerHTML = '';
          horsesEmptyState.style.display = 'block';
          return;
        }

        horsesEmptyState.style.display = 'none';

        horsesGridContainer.innerHTML = filtered
          .map((horse) => {
            const activeSponsorsCount = sponsors.filter(
              (s) => s.caballo_id === horse.id && s.estado === 'activo'
            ).length;

            const photoSrc = horse.foto || '/placeholders/horse-01.svg';
            const manadaObj = manadasList.find((m) => m.id === horse.manada_id);

            return `
              <article class="horse-admin-card" data-id="${horse.id}">
                <div class="horse-card-media">
                  <img
                    src="${photoSrc}"
                    alt="${escapeHtml(horse.nombre)}"
                    class="horse-card-img"
                    onerror="this.src='/placeholders/horse-01.svg'"
                  />
                  <div class="horse-card-status">
                    <span class="status-tag ${horse.estado}">${horse.estado}</span>
                  </div>
                </div>
                <div class="horse-card-body">
                  <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.35rem;">
                    <h3 class="horse-card-title">${escapeHtml(horse.nombre)}</h3>
                    ${
                      manadaObj
                        ? `<span class="manada-tag" style="border-left: 3px solid ${manadaObj.color || '#244137'};">${escapeHtml(manadaObj.nombre)}</span>`
                        : `<span class="manada-tag" style="color: var(--muted);">Sin manada</span>`
                    }
                  </div>
                  <p class="horse-card-desc">${escapeHtml(horse.descripcion || 'Sin descripción cargada.')}</p>
                  
                  <div class="horse-card-meta">
                    <span class="sponsor-count-pill ${activeSponsorsCount === 0 ? 'empty' : ''}">
                      <span>👥</span> ${activeSponsorsCount} ${activeSponsorsCount === 1 ? 'padrino' : 'padrinos'}
                    </span>

                    <div class="row-actions">
                      <button
                        type="button"
                        class="btn-icon btn-view-horse-sponsors"
                        data-id="${horse.id}"
                        title="Ver padrinos de este caballo"
                      >📋</button>
                      <button
                        type="button"
                        class="btn-icon btn-edit-horse"
                        data-id="${horse.id}"
                        title="Editar caballo"
                      >✏️</button>
                      <button
                        type="button"
                        class="btn-icon delete btn-delete-horse"
                        data-id="${horse.id}"
                        title="Eliminar caballo"
                      >🗑️</button>
                    </div>
                  </div>
                </div>
              </article>
            `;
          })
          .join('');

        document.querySelectorAll('.btn-edit-horse').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLElement).getAttribute('data-id')!;
            openEditHorseModal(id);
          });
        });

        document.querySelectorAll('.btn-delete-horse').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLElement).getAttribute('data-id')!;
            deleteHorse(id);
          });
        });

        document.querySelectorAll('.btn-view-horse-sponsors').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLElement).getAttribute('data-id')!;
            filterHorse.value = id;
            switchTab('sponsors');
            renderTable();
          });
        });
      }

      function openAddHorseModal() {
        (document.getElementById('formHorseId') as HTMLInputElement).value = '';
        horseForm.reset();
        selectedHorseFile = null;
        imagePreviewImg.src = '';
        imagePreviewImg.style.display = 'none';
        imageUploadPlaceholder.style.display = 'flex';
        uploadStatusText.style.display = 'none';
        formHorseFoto.value = '/placeholders/horse-01.svg';
        formHorseManada.value = '';
        (document.getElementById('formHorseEstado') as HTMLSelectElement).value = 'disponible';
        horseModalTitle.textContent = 'Nuevo Caballo';
        horseModal.classList.add('open');
      }

      function openEditHorseModal(id: string) {
        const horse = horsesList.find((h) => h.id === id);
        if (!horse) return;

        (document.getElementById('formHorseId') as HTMLInputElement).value = horse.id;
        (document.getElementById('formHorseNombre') as HTMLInputElement).value = horse.nombre;
        formHorseFoto.value = horse.foto || '/placeholders/horse-01.svg';
        formHorseManada.value = horse.manada_id || '';
        (document.getElementById('formHorseEstado') as HTMLSelectElement).value = horse.estado || 'disponible';
        (document.getElementById('formHorseDescripcion') as HTMLTextAreaElement).value = horse.descripcion || '';

        selectedHorseFile = null;
        uploadStatusText.style.display = 'none';
        if (horse.foto && !horse.foto.startsWith('/placeholders')) {
          imagePreviewImg.src = horse.foto;
          imagePreviewImg.style.display = 'block';
          imageUploadPlaceholder.style.display = 'none';
        } else {
          imagePreviewImg.src = '';
          imagePreviewImg.style.display = 'none';
          imageUploadPlaceholder.style.display = 'flex';
        }

        horseModalTitle.textContent = 'Editar Caballo';
        horseModal.classList.add('open');
      }

      function closeHorseModal() {
        horseModal.classList.remove('open');
      }

      horseForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const id = (document.getElementById('formHorseId') as HTMLInputElement).value;
        const nombre = (document.getElementById('formHorseNombre') as HTMLInputElement).value.trim();
        let foto = formHorseFoto.value.trim() || '/placeholders/horse-01.svg';
        const manada_id = formHorseManada.value || null;
        const targetManada = manadasList.find((m) => m.id === manada_id);
        const manada_nombre = targetManada ? targetManada.nombre : null;
        const estado = (document.getElementById('formHorseEstado') as HTMLSelectElement).value as any;
        const descripcion = (document.getElementById('formHorseDescripcion') as HTMLTextAreaElement).value.trim() || undefined;

        if (selectedHorseFile) {
          if (isLiveDb && supabase) {
            uploadStatusText.style.display = 'block';
            uploadStatusText.textContent = 'Subiendo foto a Supabase...';
            btnHorseModalSave.disabled = true;

            try {
              const fileExt = selectedHorseFile.name.split('.').pop() || 'jpg';
              const cleanName = nombre.toLowerCase().replace(/[^a-z0-9]/g, '-');
              const fileName = `${cleanName || 'caballo'}-${Date.now()}.${fileExt}`;
              const filePath = `fotos/${fileName}`;

              const { error: uploadError } = await supabase.storage
                .from('caballos')
                .upload(filePath, selectedHorseFile, {
                  cacheControl: '3600',
                  upsert: true,
                });

              if (uploadError) throw uploadError;

              const { data: publicUrlData } = supabase.storage
                .from('caballos')
                .getPublicUrl(filePath);

              foto = publicUrlData.publicUrl;
            } catch (uploadErr: any) {
              console.error(uploadErr);
              showToast(`Error al subir imagen: ${uploadErr.message || 'Verificá el bucket'}`, true);
              btnHorseModalSave.disabled = false;
              uploadStatusText.style.display = 'none';
              return;
            } finally {
              btnHorseModalSave.disabled = false;
              uploadStatusText.style.display = 'none';
            }
          } else {
            const reader = new FileReader();
            foto = await new Promise((resolve) => {
              reader.onload = () => resolve(reader.result as string);
              reader.readAsDataURL(selectedHorseFile!);
            });
          }
        }

        const payload: Partial<HorseRecord> = {
          nombre,
          foto,
          estado,
          manada_id: manada_id || undefined,
          manada_nombre: manada_nombre || undefined,
          descripcion,
        };

        if (id) {
          if (isLiveDb && supabase) {
            const { error } = await supabase.from('caballos').update(payload).eq('id', id);
            if (error) {
              console.error(error);
              showToast('Error al actualizar en Supabase', true);
              return;
            }
          }
          const idx = horsesList.findIndex((h) => h.id === id);
          if (idx !== -1) horsesList[idx] = { ...horsesList[idx], ...payload };
          showToast('Caballo actualizado con éxito');
        } else {
          const newId = isLiveDb ? undefined : `local-horse-${Date.now()}`;
          if (isLiveDb && supabase) {
            const { data, error } = await supabase.from('caballos').insert([payload]).select().single();
            if (error) {
              console.error(error);
              showToast('Error al guardar caballo en Supabase', true);
              return;
            }
            if (data) horsesList.unshift(data);
          } else {
            const newHorse = { ...payload, id: newId!, created_at: new Date().toISOString() } as HorseRecord;
            horsesList.unshift(newHorse);
          }
          showToast('Nuevo caballo registrado');
        }

        if (!isLiveDb) saveLocalHorses();

        closeHorseModal();
        updateHorseSelectDropdowns();
        renderManadasBoard();
        renderHorsesGrid();
        updateBadges();
      });

      async function deleteHorse(id: string) {
        const horse = horsesList.find((h) => h.id === id);
        if (!horse) return;

        const assignedSponsors = sponsors.filter((s) => s.caballo_id === id);
        if (assignedSponsors.length > 0) {
          alert(`No se puede eliminar a ${horse.nombre} porque tiene ${assignedSponsors.length} padrino(s) asignado(s). Primero cambiales de caballo o ponelo en estado "Pausado".`);
          return;
        }

        if (!confirm(`¿Eliminar a ${horse.nombre} de la manada?`)) return;

        if (isLiveDb && supabase) {
          const { error } = await supabase.from('caballos').delete().eq('id', id);
          if (error) {
            console.error(error);
            showToast('Error al eliminar en Supabase', true);
            return;
          }
        }

        horsesList = horsesList.filter((h) => h.id !== id);
        if (!isLiveDb) saveLocalHorses();

        updateHorseSelectDropdowns();
        renderManadasBoard();
        renderHorsesGrid();
        updateBadges();
        showToast('Caballo eliminado');
      }

      // ==========================================
      // SELECTOR MÚLTIPLE DE CABALLOS (A-Z + BÚSQUEDA)
      // ==========================================
      function renderHorsePicker(searchQuery = '') {
        const query = searchQuery.toLowerCase().trim();

        // 1. Ordenar alfabéticamente A-Z
        const sortedHorses = [...horsesList].sort((a, b) =>
          a.nombre.localeCompare(b.nombre, 'es', { sensitivity: 'base' })
        );

        // 2. Filtrar por búsqueda
        const filteredHorses = sortedHorses.filter(
          (h) => h.nombre.toLowerCase().includes(query) || (h.manada_nombre && h.manada_nombre.toLowerCase().includes(query))
        );

        // 3. Renderizar chips de seleccionados
        if (selectedHorseIds.size === 0) {
          pickerSelectedSummary.innerHTML = `<span class="picker-hint">Ningún caballo seleccionado todavía. Elegí uno o varios de la lista:</span>`;
        } else {
          const chipsHtml = Array.from(selectedHorseIds)
            .map((hId) => {
              const hObj = horsesList.find((h) => h.id === hId);
              const name = hObj ? hObj.nombre : hId;
              return `
                <span class="picker-chip">
                  <span>${escapeHtml(name)}</span>
                  <button type="button" class="picker-chip-remove" data-id="${hId}" title="Quitar">✕</button>
                </span>
              `;
            })
            .join('');

          pickerSelectedSummary.innerHTML = `
            ${chipsHtml}
            <span style="font-size: 0.72rem; color: var(--muted); margin-left: auto;">${selectedHorseIds.size} ${selectedHorseIds.size === 1 ? 'caballo seleccionado' : 'caballos seleccionados'}</span>
          `;
        }

        // 4. Renderizar lista scrolleable
        if (filteredHorses.length === 0) {
          pickerHorsesList.innerHTML = `<div style="padding: 1rem; text-align: center; color: var(--muted); font-size: 0.85rem;">No se encontraron caballos con ese nombre.</div>`;
          return;
        }

        pickerHorsesList.innerHTML = filteredHorses
          .map((h) => {
            const isSelected = selectedHorseIds.has(h.id);
            const manadaObj = manadasList.find((m) => m.id === h.manada_id);

            return `
              <div class="picker-horse-row ${isSelected ? 'selected' : ''}" data-id="${h.id}">
                <div class="picker-horse-left">
                  <img
                    src="${h.foto || '/placeholders/horse-01.svg'}"
                    alt="${escapeHtml(h.nombre)}"
                    class="picker-horse-thumb"
                    onerror="this.src='/placeholders/horse-01.svg'"
                  />
                  <div>
                    <span class="picker-horse-name">${escapeHtml(h.nombre)}</span>
                    ${manadaObj ? `<span class="picker-horse-manada">${escapeHtml(manadaObj.nombre)}</span>` : ''}
                  </div>
                </div>

                <div class="picker-check-indicator">
                  ${isSelected ? '✓' : ''}
                </div>
              </div>
            `;
          })
          .join('');

        // Listeners para filas de caballos
        pickerHorsesList.querySelectorAll('.picker-horse-row').forEach((row) => {
          row.addEventListener('click', () => {
            const id = row.getAttribute('data-id')!;
            if (selectedHorseIds.has(id)) {
              selectedHorseIds.delete(id);
            } else {
              selectedHorseIds.add(id);
            }
            renderHorsePicker(pickerHorseSearch.value);
          });
        });

        // Listeners para quitar chips
        pickerSelectedSummary.querySelectorAll('.picker-chip-remove').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const id = (e.currentTarget as HTMLElement).getAttribute('data-id')!;
            selectedHorseIds.delete(id);
            renderHorsePicker(pickerHorseSearch.value);
          });
        });
      }

      pickerHorseSearch.addEventListener('input', () => {
        renderHorsePicker(pickerHorseSearch.value);
      });

      // ==========================================
      // GESTIÓN DE PADRINOS (CARGA Y CRUD)
      // ==========================================
      async function loadSponsorsData() {
        let loadedSponsors: Sponsor[] = [];
        const localSponsorsRaw = localStorage.getItem('almas_sponsors');
        const localSponsors: Sponsor[] = localSponsorsRaw ? JSON.parse(localSponsorsRaw) : [];

        if (isLiveDb && supabase) {
          try {
            const { data: sponsorsData, error: sponsorsError } = await supabase
              .from('padrinos')
              .select('*')
              .order('created_at', { ascending: false });

            if (sponsorsError) {
              console.warn('[AlmasLibres] Error al leer padrinos en Supabase:', sponsorsError.message);
              // Fallback a localStorage
              loadedSponsors = localSponsors;
            } else if (sponsorsData && sponsorsData.length > 0) {
              loadedSponsors = sponsorsData;

              // Si en localStorage había padrinos que no están en Supabase, los unificamos
              if (localSponsors.length > 0) {
                const supabaseIds = new Set(sponsorsData.map((s) => s.id));
                const missingInSupabase = localSponsors.filter((ls) => !supabaseIds.has(ls.id));
                if (missingInSupabase.length > 0) {
                  console.log(`[AlmasLibres] Unificando ${missingInSupabase.length} padrinos guardados localmente...`);
                  loadedSponsors = [...missingInSupabase, ...loadedSponsors];

                  // Subir los faltantes a Supabase en segundo plano
                  try {
                    const toInsert = missingInSupabase.map(({ id, created_at, ...rest }: any) => rest);
                    await supabase.from('padrinos').insert(toInsert);
                  } catch (syncErr) {
                    console.warn('[AlmasLibres] Auto-sincronización a Supabase diferida:', syncErr);
                  }
                }
              }
            } else {
              // Supabase está conectado pero no tiene filas:
              // Verificamos si el usuario había cargado padrinos en localStorage
              if (localSponsors.length > 0) {
                console.log(`[AlmasLibres] Recuperando ${localSponsors.length} padrinos desde almacenamiento local...`);
                loadedSponsors = localSponsors;

                // Intentamos migrarlos automáticamente a Supabase
                try {
                  const toInsert = localSponsors.map(({ id, created_at, ...rest }: any) => rest);
                  const { data: inserted, error: insertErr } = await supabase.from('padrinos').insert(toInsert).select();
                  if (!insertErr && inserted && inserted.length > 0) {
                    loadedSponsors = inserted;
                  }
                } catch (syncErr) {
                  console.warn('[AlmasLibres] Error migrando padrinos locales a Supabase:', syncErr);
                }
              }
            }

            try {
              await loadReportsForYear(activeYear);
            } catch (repErr) {
              console.warn('[AlmasLibres] Error cargando reportes:', repErr);
            }
          } catch (err) {
            console.warn('[AlmasLibres] Error de conexión con Supabase, usando copia local:', err);
            loadedSponsors = localSponsors;
          }
        } else {
          loadedSponsors = localSponsors;
          try {
            await loadReportsForYear(activeYear);
          } catch (repErr) {
            console.warn('[AlmasLibres] Error cargando reportes locales:', repErr);
          }
        }

        sponsors = loadedSponsors;
        // Guardar siempre copia de seguridad en localStorage
        saveLocalStorage();

        renderTable();
        updateMetrics();
        updateBadges();
      }

      async function loadReportsForYear(year: number) {
        const localReportsRaw = localStorage.getItem(`almas_reports_${year}`);
        const localReports: MonthlyReportRecord[] = localReportsRaw ? JSON.parse(localReportsRaw) : [];

        if (isLiveDb && supabase) {
          try {
            const { data: reportsData, error: reportsError } = await supabase
              .from('reportes_mensuales')
              .select('*')
              .eq('anio', year);

            if (reportsError) {
              console.warn('[AlmasLibres] Error en reportes de Supabase:', reportsError.message);
              reports = localReports;
            } else {
              reports = reportsData || [];
              if (reports.length === 0 && localReports.length > 0) {
                reports = localReports;
                try {
                  const toInsert = localReports.map(({ id, ...rest }: any) => rest);
                  await supabase.from('reportes_mensuales').upsert(toInsert, { onConflict: 'padrino_id,anio,mes' });
                } catch (e) {
                  console.warn('[AlmasLibres] Sincronización de reportes locales diferida:', e);
                }
              }
            }
          } catch (err) {
            console.warn('[AlmasLibres] Error de conexión en reportes:', err);
            reports = localReports;
          }
        } else {
          reports = localReports;
        }

        if (reports.length > 0) {
          localStorage.setItem(`almas_reports_${year}`, JSON.stringify(reports));
        }

        renderTable();
        updateMetrics();
      }

      function saveLocalStorage() {
        localStorage.setItem('almas_sponsors', JSON.stringify(sponsors));
        localStorage.setItem(`almas_reports_${activeYear}`, JSON.stringify(reports));
      }

      function updateBadges() {
        tabBadgeSponsors.textContent = String(sponsors.filter((s) => (s.estado || 'activo').toLowerCase() === 'activo').length);
        tabBadgeHorses.textContent = String(horsesList.length);
        const horsesCountEl = document.getElementById('metricTotalHorsesCount');
        if (horsesCountEl) {
          horsesCountEl.textContent = `de ${horsesList.length} en la manada`;
        }
      }

      // Render de la Tabla de Padrinos
      function renderTable() {
        const query = (searchInput.value || '').toLowerCase().trim();
        const selectedHorse = filterHorse ? filterHorse.value || 'all' : 'all';
        const selectedManada = filterManada ? filterManada.value || 'all' : 'all';
        const selectedStatus = filterStatus ? filterStatus.value || 'all' : 'all';

        const filtered = sponsors.filter((sp) => {
          const spName = (sp.nombre || '').toLowerCase();
          const spPhone = (sp.telefono || '').toLowerCase();
          const spEmail = (sp.email || '').toLowerCase();
          const spHorseName = (sp.caballo_nombre || '').toLowerCase();

          const matchesQuery =
            !query ||
            spName.includes(query) ||
            spPhone.includes(query) ||
            spEmail.includes(query) ||
            spHorseName.includes(query);

          // Coincidencia de caballo: por ID, slug o nombre
          let matchesHorse = true;
          if (selectedHorse !== 'all') {
            const matchedHorse = horsesList.find(
              (h) =>
                h.id === sp.caballo_id ||
                h.slug === sp.caballo_id ||
                (h.nombre && sp.caballo_nombre && h.nombre.toLowerCase().trim() === sp.caballo_nombre.toLowerCase().trim())
            );
            matchesHorse = sp.caballo_id === selectedHorse || (!!matchedHorse && matchedHorse.id === selectedHorse);
          }

          // Coincidencia de estado (insensible a mayúsculas/minúsculas)
          let matchesStatus = true;
          if (selectedStatus !== 'all') {
            const spStatus = (sp.estado || 'activo').toLowerCase();
            matchesStatus = spStatus === selectedStatus.toLowerCase();
          }

          // Filtro por manada
          let matchesManada = true;
          if (selectedManada !== 'all') {
            const matchedHorse = horsesList.find(
              (h) =>
                h.id === sp.caballo_id ||
                h.slug === sp.caballo_id ||
                (h.nombre && sp.caballo_nombre && h.nombre.toLowerCase().trim() === sp.caballo_nombre.toLowerCase().trim())
            );
            if (selectedManada === 'none') {
              matchesManada = !matchedHorse || !matchedHorse.manada_id;
            } else {
              matchesManada = !!matchedHorse && matchedHorse.manada_id === selectedManada;
            }
          }

          return matchesQuery && matchesHorse && matchesStatus && matchesManada;
        });

        if (filtered.length === 0) {
          sponsorsTableBody.innerHTML = '';
          emptyState.style.display = 'block';
          return;
        }

        emptyState.style.display = 'none';

        sponsorsTableBody.innerHTML = filtered
          .map((sp) => {
            const monthCells = Array.from({ length: 12 }, (_, i) => {
              const month = i + 1;
              const isSent = reports.some(
                (r) => r.padrino_id === sp.id && r.anio === activeYear && r.mes === month && r.enviado
              );
              const isCurrent = month === config.currentMonth && activeYear === config.currentYear;

              return `
                <td class="month-cell ${isCurrent ? 'current-month' : ''}">
                  <button
                    type="button"
                    class="report-toggle-btn ${isSent ? 'sent' : ''}"
                    data-padrino-id="${sp.id}"
                    data-month="${month}"
                    title="${isSent ? `Reporte ${MONTH_NAMES[i]} ${activeYear} enviado` : `Marcar reporte ${MONTH_NAMES[i]} ${activeYear} como enviado`}"
                  >
                    ${isSent ? '✓' : '•'}
                  </button>
                </td>
              `;
            }).join('');

            const cleanPhone = (sp.telefono || '').replace(/\D/g, '');
            const waText = encodeURIComponent(
              `¡Hola ${sp.nombre}! 🐴 Te escribimos desde Fundación Almas Libres con las novedades de este mes de ${sp.caballo_nombre}. ¡Gracias por ser parte de su cuidado!`
            );
            const waUrl = cleanPhone ? `https://wa.me/${cleanPhone}?text=${waText}` : null;

            // Datos del caballo (foto miniatura y nombre abajo)
            const matchedHorse = horsesList.find(
              (h) =>
                h.id === sp.caballo_id ||
                h.slug === sp.caballo_id ||
                h.nombre.toLowerCase().trim() === (sp.caballo_nombre || '').toLowerCase().trim()
            );
            const horsePhoto = matchedHorse?.foto || '/placeholders/horse-01.svg';
            const horseName = matchedHorse?.nombre || sp.caballo_nombre || 'Caballo';

            return `
              <tr data-id="${sp.id}">
                <td class="padrino-info-cell">
                  <span class="padrino-name">${escapeHtml(sp.nombre)}</span>
                  <div class="padrino-meta">
                    <span class="status-tag ${sp.estado}">${sp.estado}</span>
                    <span>Desde ${sp.fecha_inicio || '-'}</span>
                  </div>
                  ${sp.notas ? `<div class="padrino-meta" style="margin-top: 4px; font-style: italic;">"${escapeHtml(sp.notas)}"</div>` : ''}
                </td>
                <td class="horse-cell center">
                  <div class="horse-cell-thumb-wrapper">
                    <img
                      src="${horsePhoto}"
                      alt="${escapeHtml(horseName)}"
                      class="horse-cell-thumb"
                      onerror="this.src='/placeholders/horse-01.svg'"
                    />
                    <span class="horse-cell-name">${escapeHtml(horseName)}</span>
                  </div>
                </td>
                <td class="contact-cell">
                  ${
                    waUrl
                      ? `<a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="whatsapp-link" title="Abrir WhatsApp">💬 ${escapeHtml(sp.telefono || '')}</a>`
                      : `<span style="color: var(--muted);">${sp.telefono ? escapeHtml(sp.telefono) : 'Sin teléfono'}</span>`
                  }
                  ${sp.email ? `<span class="email-text">✉️ ${escapeHtml(sp.email)}</span>` : ''}
                </td>
                <td style="font-weight: 600; white-space: nowrap;">
                  ${sp.monto ? `$${Number(sp.monto).toLocaleString('es-AR')} ${sp.moneda || 'ARS'}` : '-'}
                </td>
                ${monthCells}
                <td class="center">
                  <div class="row-actions">
                    <button type="button" class="btn-icon btn-edit" data-id="${sp.id}" title="Editar padrino">✏️</button>
                    <button type="button" class="btn-icon delete btn-delete" data-id="${sp.id}" title="Eliminar padrino">🗑️</button>
                  </div>
                </td>
              </tr>
            `;
          })
          .join('');

        document.querySelectorAll('.report-toggle-btn').forEach((btn) => {
          btn.addEventListener('click', handleReportToggle);
        });

        document.querySelectorAll('.btn-edit').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
            openEditModal(id!);
          });
        });

        document.querySelectorAll('.btn-delete').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
            deleteSponsor(id!);
          });
        });
      }

      // Alternar estado de reporte mensual
      async function handleReportToggle(e: Event) {
        const btn = e.currentTarget as HTMLButtonElement;
        const padrinoId = btn.getAttribute('data-padrino-id')!;
        const month = Number(btn.getAttribute('data-month'));
        const isCurrentlySent = btn.classList.contains('sent');
        const nextState = !isCurrentlySent;

        btn.classList.toggle('sent', nextState);
        btn.innerHTML = nextState ? '✓' : '•';

        if (isLiveDb && supabase) {
          try {
            if (nextState) {
              const { error } = await supabase.from('reportes_mensuales').upsert({
                padrino_id: padrinoId,
                anio: activeYear,
                mes: month,
                enviado: true,
                updated_at: new Date().toISOString(),
              }, { onConflict: 'padrino_id,anio,mes' });
              if (error) throw error;
            } else {
              const { error } = await supabase
                .from('reportes_mensuales')
                .delete()
                .eq('padrino_id', padrinoId)
                .eq('anio', activeYear)
                .eq('mes', month);
              if (error) throw error;
            }
          } catch (err) {
            console.error('Error actualizando reporte en Supabase:', err);
            showToast('Error de sincronización con la base', true);
            btn.classList.toggle('sent', isCurrentlySent);
            btn.innerHTML = isCurrentlySent ? '✓' : '•';
            return;
          }
        }

        if (nextState) {
          reports.push({ padrino_id: padrinoId, anio: activeYear, mes: month, enviado: true });
        } else {
          reports = reports.filter(
            (r) => !(r.padrino_id === padrinoId && r.anio === activeYear && r.mes === month)
          );
        }

        if (!isLiveDb) saveLocalStorage();

        updateMetrics();
        showToast(nextState ? `Reporte de ${MONTH_NAMES[month - 1]} marcado como enviado` : `Reporte desmarcado`);
      }

      // Actualizar Métricas
      function updateMetrics() {
        const activeSponsors = sponsors.filter((s) => s.estado === 'activo');
        document.getElementById('metricActiveSponsors')!.textContent = String(activeSponsors.length);
        document.getElementById('metricTotalSponsors')!.textContent = `Total apadrinamientos: ${sponsors.length}`;

        const uniqueHorses = new Set(activeSponsors.map((s) => s.caballo_id));
        document.getElementById('metricSponsoredHorses')!.textContent = String(uniqueHorses.size);

        const curM = config.currentMonth;
        let sentThisMonth = 0;
        activeSponsors.forEach((sp) => {
          const sent = reports.some(
            (r) => r.padrino_id === sp.id && r.anio === config.currentYear && r.mes === curM && r.enviado
          );
          if (sent) sentThisMonth++;
        });

        const pendingThisMonth = activeSponsors.length - sentThisMonth;
        document.getElementById('metricMonthReports')!.textContent = `${sentThisMonth} / ${activeSponsors.length}`;
        const pendingEl = document.getElementById('metricMonthPending')!;
        pendingEl.textContent = `${pendingThisMonth} pendientes de envío`;
        pendingEl.className = pendingThisMonth > 0 ? 'metric-sub warning' : 'metric-sub';

        const totalFunds = activeSponsors.reduce((acc, s) => acc + (Number(s.monto) || 0), 0);
        document.getElementById('metricMonthlyFunds')!.textContent = `$${totalFunds.toLocaleString('es-AR')}`;
      }

      // Modal Alta / Edición Padrino
      function openAddModal() {
        (document.getElementById('formSponsorId') as HTMLInputElement).value = '';
        sponsorForm.reset();
        (document.getElementById('formFechaInicio') as HTMLInputElement).value = new Date().toISOString().split('T')[0];
        modalTitle.textContent = 'Nuevo Padrino';

        // Resetear selección múltiple de caballos
        selectedHorseIds.clear();
        pickerHorseSearch.value = '';
        renderHorsePicker();

        sponsorModal.classList.add('open');
      }

      function openEditModal(id: string) {
        const sp = sponsors.find((s) => s.id === id);
        if (!sp) return;

        (document.getElementById('formSponsorId') as HTMLInputElement).value = sp.id;
        (document.getElementById('formNombre') as HTMLInputElement).value = sp.nombre;
        (document.getElementById('formFechaInicio') as HTMLInputElement).value = sp.fecha_inicio || '';
        (document.getElementById('formEstado') as HTMLSelectElement).value = sp.estado;
        (document.getElementById('formTelefono') as HTMLInputElement).value = sp.telefono || '';
        (document.getElementById('formEmail') as HTMLInputElement).value = sp.email || '';
        (document.getElementById('formMonto') as HTMLInputElement).value = sp.monto ? String(sp.monto) : '';
        (document.getElementById('formMoneda') as HTMLSelectElement).value = sp.moneda || 'ARS';
        (document.getElementById('formNotas') as HTMLTextAreaElement).value = sp.notas || '';

        // En edición, cargamos el caballo actual en la selección
        selectedHorseIds.clear();
        if (sp.caballo_id) {
          selectedHorseIds.add(sp.caballo_id);
        }
        pickerHorseSearch.value = '';
        renderHorsePicker();

        modalTitle.textContent = 'Editar Padrino';
        sponsorModal.classList.add('open');
      }

      function closeModal() {
        sponsorModal.classList.remove('open');
      }

      sponsorForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (selectedHorseIds.size === 0) {
          alert('Por favor seleccioná al menos un caballo para apadrinar.');
          return;
        }

        const id = (document.getElementById('formSponsorId') as HTMLInputElement).value;
        const nombre = (document.getElementById('formNombre') as HTMLInputElement).value.trim();
        const fecha_inicio = (document.getElementById('formFechaInicio') as HTMLInputElement).value;
        const estado = (document.getElementById('formEstado') as HTMLSelectElement).value as any;
        const telefono = (document.getElementById('formTelefono') as HTMLInputElement).value.trim() || undefined;
        const email = (document.getElementById('formEmail') as HTMLInputElement).value.trim() || undefined;
        const monto = Number((document.getElementById('formMonto') as HTMLInputElement).value) || undefined;
        const moneda = (document.getElementById('formMoneda') as HTMLSelectElement).value;
        const notas = (document.getElementById('formNotas') as HTMLTextAreaElement).value.trim() || undefined;

        if (id) {
          // Edición de un registro existente
          const firstSelectedHorseId = Array.from(selectedHorseIds)[0];
          const matchedHorse = horsesList.find((h) => h.id === firstSelectedHorseId);
          const caballo_nombre = matchedHorse ? matchedHorse.nombre : 'Caballo';

          const payload: Partial<Sponsor> = {
            nombre,
            caballo_id: firstSelectedHorseId,
            caballo_nombre,
            fecha_inicio,
            estado,
            telefono,
            email,
            monto,
            moneda,
            notas,
          };

          if (isLiveDb && supabase) {
            const { error } = await supabase.from('padrinos').update(payload).eq('id', id);
            if (error) {
              console.error(error);
              showToast('Error al actualizar en Supabase', true);
              return;
            }
          }
          const idx = sponsors.findIndex((s) => s.id === id);
          if (idx !== -1) sponsors[idx] = { ...sponsors[idx], ...payload };
          showToast('Padrino actualizado con éxito');
        } else {
          // Alta: Soporta apadrinar MÚLTIPLES caballos simultáneamente
          const horseIdsArray = Array.from(selectedHorseIds);
          const newSponsorsToInsert: Array<Omit<Sponsor, 'id'>> = horseIdsArray.map((horseId) => {
            const matchedHorse = horsesList.find((h) => h.id === horseId);
            return {
              nombre,
              caballo_id: horseId,
              caballo_nombre: matchedHorse ? matchedHorse.nombre : 'Caballo',
              fecha_inicio,
              estado,
              telefono,
              email,
              monto,
              moneda,
              notas,
            };
          });

          if (isLiveDb && supabase) {
            const { data, error } = await supabase.from('padrinos').insert(newSponsorsToInsert).select();
            if (error) {
              console.error(error);
              showToast('Error al guardar en Supabase', true);
              return;
            }
            if (data && data.length > 0) {
              sponsors.unshift(...data);
            }
          } else {
            newSponsorsToInsert.forEach((sp, i) => {
              sponsors.unshift({
                ...sp,
                id: `local-${Date.now()}-${i}`,
                created_at: new Date().toISOString(),
              });
            });
          }

          showToast(
            horseIdsArray.length > 1
              ? `Se registraron los apadrinamientos para los ${horseIdsArray.length} caballos`
              : 'Nuevo padrino registrado'
          );
        }

        if (!isLiveDb) saveLocalStorage();

        closeModal();
        renderTable();
        updateMetrics();
        updateBadges();
      });

      async function deleteSponsor(id: string) {
        const sp = sponsors.find((s) => s.id === id);
        if (!confirm(`¿Eliminar el apadrinamiento de ${sp?.nombre || 'este padrino'} para ${sp?.caballo_nombre || 'el caballo'}?`)) return;

        if (isLiveDb && supabase) {
          const { error } = await supabase.from('padrinos').delete().eq('id', id);
          if (error) {
            console.error(error);
            showToast('Error al eliminar en Supabase', true);
            return;
          }
        }

        sponsors = sponsors.filter((s) => s.id !== id);
        reports = reports.filter((r) => r.padrino_id !== id);

        if (!isLiveDb) saveLocalStorage();

        renderTable();
        updateMetrics();
        updateBadges();
        showToast('Apadrinamiento eliminado');
      }

      // Exportar a CSV / Excel
      function exportToCsv() {
        if (sponsors.length === 0) {
          alert('No hay padrinos para exportar.');
          return;
        }

        const headers = [
          'Nombre',
          'Caballo',
          'ID Caballo',
          'Estado',
          'Fecha Inicio',
          'Telefono',
          'Email',
          'Aporte Mensual',
          'Moneda',
          'Notas',
          ...MONTH_NAMES.map((m) => `${m} ${activeYear}`),
        ];

        const rows = sponsors.map((sp) => {
          const monthValues = Array.from({ length: 12 }, (_, i) => {
            const isSent = reports.some(
              (r) => r.padrino_id === sp.id && r.anio === activeYear && r.mes === i + 1 && r.enviado
            );
            return isSent ? 'SI' : 'NO';
          });

          return [
            `"${(sp.nombre || '').replace(/"/g, '""')}"`,
            `"${(sp.caballo_nombre || '').replace(/"/g, '""')}"`,
            `"${sp.caballo_id || ''}"`,
            `"${sp.estado}"`,
            `"${sp.fecha_inicio || ''}"`,
            `"${sp.telefono || ''}"`,
            `"${sp.email || ''}"`,
            `"${sp.monto || 0}"`,
            `"${sp.moneda || 'ARS'}"`,
            `"${(sp.notas || '').replace(/"/g, '""')}"`,
            ...monthValues,
          ].join(';');
        });

        const csvContent = '\uFEFF' + [headers.join(';'), ...rows].join('\r\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `padrinos-almas-libres-${activeYear}.csv`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        showToast('Planilla CSV descargada');
      }

      // Configurar Listeners generales
      function setupEventListeners() {
        // Pestañas Principales
        tabBtnSponsors.addEventListener('click', () => switchTab('sponsors'));
        tabBtnHorses.addEventListener('click', () => switchTab('horses'));

        // Subnavegación de caballos
        subnavBtnManadas.addEventListener('click', () => switchHorsesSubView('manadas'));
        subnavBtnAllHorses.addEventListener('click', () => switchHorsesSubView('all'));

        // Padrinos Modales
        btnOpenAddModal.addEventListener('click', openAddModal);
        btnModalClose.addEventListener('click', closeModal);
        btnModalCancel.addEventListener('click', closeModal);
        sponsorModal.addEventListener('click', (e) => {
          if (e.target === sponsorModal) closeModal();
        });

        // Caballos Modales
        btnOpenAddHorseModal.addEventListener('click', openAddHorseModal);
        btnQuickAddHorse.addEventListener('click', openAddHorseModal);
        btnHorseModalClose.addEventListener('click', closeHorseModal);
        btnHorseModalCancel.addEventListener('click', closeHorseModal);
        horseModal.addEventListener('click', (e) => {
          if (e.target === horseModal) closeHorseModal();
        });

        // Manadas Modales
        btnOpenAddManadaModal.addEventListener('click', openAddManadaModal);
        btnManadaModalClose.addEventListener('click', closeManadaModal);
        btnManadaModalCancel.addEventListener('click', closeManadaModal);
        manadaModal.addEventListener('click', (e) => {
          if (e.target === manadaModal) closeManadaModal();
        });

        // Subida de imagen y vista previa inmediata
        imagePreviewBox.addEventListener('click', () => {
          formHorseFileInput.click();
        });

        formHorseFileInput.addEventListener('change', () => {
          if (formHorseFileInput.files && formHorseFileInput.files[0]) {
            selectedHorseFile = formHorseFileInput.files[0];
            const previewUrl = URL.createObjectURL(selectedHorseFile);
            imagePreviewImg.src = previewUrl;
            imagePreviewImg.style.display = 'block';
            imageUploadPlaceholder.style.display = 'none';
          }
        });

        // Búsquedas y filtros
        searchInput.addEventListener('input', renderTable);
        filterHorse.addEventListener('change', renderTable);
        filterManada.addEventListener('change', renderTable);
        filterStatus.addEventListener('change', renderTable);

        const btnResetFilters = document.getElementById('btnResetFilters');
        if (btnResetFilters) {
          btnResetFilters.addEventListener('click', () => {
            searchInput.value = '';
            filterHorse.value = 'all';
            filterManada.value = 'all';
            filterStatus.value = 'all';
            renderTable();
          });
        }

        searchHorsesInput.addEventListener('input', renderHorsesGrid);
        filterHorseStatus.addEventListener('change', renderHorsesGrid);
        filterHorseManadaSelect.addEventListener('change', renderHorsesGrid);

        btnExportCsv.addEventListener('click', exportToCsv);
      }

      function showToast(msg: string, isError = false) {
        toastMessage.textContent = msg;
        toastEl.style.background = isError ? '#c92a2a' : 'var(--green-2)';
        toastEl.classList.add('show');
        setTimeout(() => toastEl.classList.remove('show'), 3000);
      }

      function escapeHtml(str: string) {
        return (str || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      // Iniciar
      initAuth();
    </script>
  </body>
</html>
