# Fundación Almas Libres — configuración pública
# No cargar secretos ni service_role keys acá.

PUBLIC_ALMAS_IS_PREVIEW=true
PUBLIC_ALMAS_WHATSAPP_NUMBER=
PUBLIC_ALMAS_EMAIL=
PUBLIC_ALMAS_PAYMENT_MODE=external
PUBLIC_ALMAS_DONATION_URL=
PUBLIC_ALMAS_SPONSORSHIP_URL=
PUBLIC_ALMAS_INSTAGRAM_URL=
PUBLIC_ALMAS_FACEBOOK_URL=

# Panel Interno de Padrinos (Supabase)
# Obtené estas dos claves gratuitas en tu proyecto de Supabase (Settings -> API)
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key

# Clave / PIN simple para acceder al panel interno (opcional, ej: 1234 o almas2026)
PUBLIC_ADMIN_PIN=almas2026
