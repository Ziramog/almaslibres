---
import '@/styles/global.css';
import '@/styles/admin.css';

const adminPin =
  import.meta.env.PUBLIC_ADMIN_PIN ||
  (import.meta.env as any).ADMIN_PIN ||
  '';
const currentYear = new Date().getFullYear();
const currentMonth = new Date().getMonth() + 1; // 1-12
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel de Gestión — Fundación Almas Libres</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body
    class="admin-body"
    data-admin-pin={adminPin}
    data-current-year={currentYear}
    data-current-month={currentMonth}
  >
    <!-- Pantalla de Bloqueo / PIN -->
    <div id="lockScreen" class="lock-screen-wrapper" style="display: none;">
      <div class="lock-card">
        <span class="lock-badge">Acceso Interno</span>
        <h1>Fundación Almas Libres</h1>
        <p>Ingresá la clave de acceso del equipo para gestionar la manada y los padrinos.</p>
        <form id="pinForm" class="pin-form" onsubmit="return false;">
          <input
            type="password"
            id="pinInput"
            class="pin-input"
            placeholder="••••"
            maxlength="20"
            autocomplete="current-password"
            required
            autofocus
          />
          <button type="submit" id="pinSubmitBtn" class="pin-submit-btn">Ingresar al Panel</button>
          <div id="pinError" class="pin-error" style="display: none;">Clave incorrecta. Intentá de nuevo.</div>
        </form>
      </div>
    </div>

    <!-- Panel de Administración -->
    <div id="adminApp" class="admin-shell" style="display: none;">
      <!-- Topbar Principal -->
      <header class="admin-topbar">
        <div class="admin-branding">
          <h1>
            <span>🐴</span> Panel de Gestión Equina
          </h1>
          <div class="admin-subtitle">
            <span>Fundación Almas Libres</span>
            <span class="status-pill live" id="dbStatusPill" style="display: none;">
              <span id="dbStatusDot">●</span> <span id="dbStatusText">En línea</span>
            </span>
          </div>
        </div>

        <div class="admin-actions">
          <!-- Selector de Año (para la planilla de reportes) -->
          <div class="year-selector-group" id="yearSelectorGroup">
            <button type="button" class="year-btn" data-year={currentYear - 1}>{currentYear - 1}</button>
            <button type="button" class="year-btn active" data-year={currentYear}>{currentYear}</button>
            <button type="button" class="year-btn" data-year={currentYear + 1}>{currentYear + 1}</button>
          </div>

          <button type="button" id="btnExportCsv" class="btn-secondary" title="Descargar como Excel/CSV">
            <span>📥</span> Exportar CSV
          </button>
          <button type="button" id="btnOpenAddHorseModal" class="btn-secondary" title="Agregar un caballo">
            <span>🐴</span> + Nuevo Caballo
          </button>
          <button type="button" id="btnOpenAddModal" class="btn-primary" title="Registrar nuevo padrino">
            <span>👤</span> + Nuevo Padrino
          </button>
          <button type="button" id="btnLogout" class="btn-secondary" style="padding: 0.65rem 0.8rem;" title="Cerrar sesión">
            <span>🔒</span>
          </button>
        </div>
      </header>

      <!-- Pestañas de Navegación -->
      <nav class="admin-nav-tabs">
        <button type="button" class="admin-tab-btn active" id="tabBtnSponsors">
          <span>📋</span> Planilla de Padrinos <span class="tab-badge" id="tabBadgeSponsors">0</span>
        </button>
        <button type="button" class="admin-tab-btn" id="tabBtnHorses">
          <span>🐴</span> Caballos y Manadas <span class="tab-badge" id="tabBadgeHorses">0</span>
        </button>
      </nav>

      <!-- ========================================== -->
      <!-- VISTA 1: PLANILLA DE PADRINOS              -->
      <!-- ========================================== -->
      <div id="viewSponsors">
        <!-- Tarjetas de Métricas -->
        <section class="metrics-row">
          <article class="metric-card">
            <div class="metric-label">Padrinos Activos</div>
            <div class="metric-value" id="metricActiveSponsors">0</div>
            <div class="metric-sub" id="metricTotalSponsors">Total apadrinamientos: 0</div>
          </article>
          <article class="metric-card">
            <div class="metric-label">Caballos con Padrino</div>
            <div class="metric-value" id="metricSponsoredHorses">0</div>
            <div class="metric-sub" id="metricTotalHorsesCount">de 0 en la manada</div>
          </article>
          <article class="metric-card">
            <div class="metric-label">Reportes de <span id="currentMonthNameLabel">este mes</span></div>
            <div class="metric-value" id="metricMonthReports">0 / 0</div>
            <div class="metric-sub warning" id="metricMonthPending">0 pendientes de envío</div>
          </article>
          <article class="metric-card">
            <div class="metric-label">Aporte Mensual Estimado</div>
            <div class="metric-value" id="metricMonthlyFunds">$0</div>
            <div class="metric-sub">Sostén para el santuario</div>
          </article>
        </section>

        <!-- Barra de Filtros y Búsqueda de Padrinos -->
        <div class="admin-filterbar">
          <div class="search-input-wrapper">
            <span class="search-icon">🔍</span>
            <input
              type="text"
              id="searchInput"
              class="search-input"
              placeholder="Buscar por nombre, teléfono o email..."
            />
          </div>

          <div class="filter-selects">
            <select id="filterHorse" class="filter-select">
              <option value="all">Todos los caballos</option>
            </select>

            <select id="filterManada" class="filter-select">
              <option value="all">Todas las manadas</option>
            </select>

            <select id="filterStatus" class="filter-select">
              <option value="all" selected>Todos los estados</option>
              <option value="activo">Solo Activos</option>
              <option value="pausado">Pausados</option>
              <option value="baja">De Baja</option>
            </select>
          </div>
        </div>

        <!-- Tabla / Planilla de Padrinos -->
        <div class="table-card">
          <div class="table-wrapper">
            <table class="padrinos-table">
              <thead>
                <tr>
                  <th>Padrino / Madrina</th>
                  <th class="center">Caballo</th>
                  <th>Contacto</th>
                  <th>Aporte</th>
                  <!-- 12 columnas de meses -->
                  <th class="th-month" data-month="1">Ene</th>
                  <th class="th-month" data-month="2">Feb</th>
                  <th class="th-month" data-month="3">Mar</th>
                  <th class="th-month" data-month="4">Abr</th>
                  <th class="th-month" data-month="5">May</th>
                  <th class="th-month" data-month="6">Jun</th>
                  <th class="th-month" data-month="7">Jul</th>
                  <th class="th-month" data-month="8">Ago</th>
                  <th class="th-month" data-month="9">Sep</th>
                  <th class="th-month" data-month="10">Oct</th>
                  <th class="th-month" data-month="11">Nov</th>
                  <th class="th-month" data-month="12">Dic</th>
                  <th class="center" style="width: 80px;">Acciones</th>
                </tr>
              </thead>
              <tbody id="sponsorsTableBody">
                <!-- Renderizado dinámico vía JavaScript -->
              </tbody>
            </table>
          </div>

          <!-- Estado vacío si no hay coincidencias -->
          <div id="emptyState" class="empty-table-state" style="display: none;">
            <div style="font-size: 2.5rem;">🐴</div>
            <h3>No se encontraron padrinos con los filtros actuales</h3>
            <p>Podés registrar uno nuevo con <strong>"+ Nuevo Padrino"</strong> o restablecer la búsqueda.</p>
            <button type="button" id="btnResetFilters" class="btn-secondary" style="margin-top: 0.75rem; display: inline-flex;">
              Restablecer Filtros
            </button>
          </div>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- VISTA 2: GESTIÓN DE CABALLOS Y MANADAS     -->
      <!-- ========================================== -->
      <div id="viewHorses" style="display: none;">
        <!-- Subnavegación de Manadas -->
        <div class="view-subnav">
          <div class="subnav-pills">
            <button type="button" class="subnav-btn active" id="subnavBtnManadas">
              <span>🗂️</span> Vista por Manadas
            </button>
            <button type="button" class="subnav-btn" id="subnavBtnAllHorses">
              <span>📋</span> Todos los Caballos (<span id="totalHorsesBadge">0</span>)
            </button>
          </div>

          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <button type="button" id="btnOpenAddManadaModal" class="btn-secondary" title="Crear un nuevo grupo/manada">
              <span>🗂️</span> + Nueva Manada
            </button>
            <button type="button" id="btnQuickAddHorse" class="btn-primary" title="Agregar un caballo">
              <span>+</span> Agregar Caballo
            </button>
          </div>
        </div>

        <!-- 2A. Tablero Visual de Manadas (Columnas por grupo) -->
        <div id="manadasBoardView">
          <div class="manadas-board" id="manadasBoardContainer">
            <!-- Renderizado dinámico vía JavaScript -->
          </div>
        </div>

        <!-- 2B. Listado General de Todos los Caballos -->
        <div id="allHorsesView" style="display: none;">
          <div class="admin-filterbar">
            <div class="search-input-wrapper">
              <span class="search-icon">🔍</span>
              <input
                type="text"
                id="searchHorsesInput"
                class="search-input"
                placeholder="Buscar caballo por nombre o historia..."
              />
            </div>

            <div class="filter-selects">
              <select id="filterHorseManadaSelect" class="filter-select">
                <option value="all">Todas las manadas</option>
              </select>

              <select id="filterHorseStatus" class="filter-select">
                <option value="all">Todos los estados</option>
                <option value="disponible" selected>Disponibles para apadrinar</option>
                <option value="pausado">Pausados</option>
                <option value="oculto">Ocultos</option>
              </select>
            </div>
          </div>

          <div class="horses-grid" id="horsesGridContainer">
            <!-- Renderizado dinámico vía JavaScript -->
          </div>

          <div id="horsesEmptyState" class="empty-table-state" style="display: none;">
            <div style="font-size: 2.5rem;">🐴</div>
            <h3>No se encontraron caballos</h3>
            <p>Podés sumar el primero haciendo clic en <strong>"+ Agregar Caballo"</strong>.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal Formulario Padrino (Alta / Edición con Selector Múltiple y Búsqueda) -->
    <div id="sponsorModal" class="modal-overlay">
      <div class="modal-window">
        <div class="modal-header">
          <h2 id="modalTitle">Nuevo Padrino</h2>
          <button type="button" id="btnModalClose" class="modal-close-btn">&times;</button>
        </div>

        <form id="sponsorForm">
          <input type="hidden" id="formSponsorId" value="" />

          <div class="form-grid">
            <div class="form-group full">
              <label for="formNombre">Nombre y Apellido *</label>
              <input type="text" id="formNombre" class="form-input" required placeholder="Ej: Marcela López" />
            </div>

            <!-- Selector Múltiple de Caballos con Búsqueda y Orden A-Z -->
            <div class="form-group full">
              <label>Caballo(s) que apadrina * <span style="font-weight: 500; color: var(--muted);">(Podés seleccionar más de uno)</span></label>
              <div class="horse-picker-container">
                <div class="picker-search-wrapper">
                  <span class="picker-search-icon">🔍</span>
                  <input
                    type="text"
                    id="pickerHorseSearch"
                    class="picker-search-input"
                    placeholder="Buscar caballo por nombre..."
                    autocomplete="off"
                  />
                </div>

                <div class="picker-selected-summary" id="pickerSelectedSummary">
                  <span class="picker-hint">Ningún caballo seleccionado todavía.</span>
                </div>

                <div class="picker-horses-list" id="pickerHorsesList">
                  <!-- Renderizado ordenado A-Z vía JavaScript -->
                </div>
              </div>
            </div>

            <div class="form-group">
              <label for="formFechaInicio">Fecha de inicio *</label>
              <input type="date" id="formFechaInicio" class="form-input" required />
            </div>

            <div class="form-group">
              <label for="formEstado">Estado</label>
              <select id="formEstado" class="form-select">
                <option value="activo">Activo</option>
                <option value="pausado">Pausado</option>
                <option value="baja">Baja</option>
              </select>
            </div>

            <div class="form-group">
              <label for="formTelefono">WhatsApp / Teléfono</label>
              <input type="tel" id="formTelefono" class="form-input" placeholder="Ej: +54 9 11 5555-1234" />
            </div>

            <div class="form-group">
              <label for="formEmail">Email</label>
              <input type="email" id="formEmail" class="form-input" placeholder="padrino@correo.com" />
            </div>

            <div class="form-group">
              <label for="formMonto">Aporte Mensual ($)</label>
              <input type="number" id="formMonto" class="form-input" placeholder="Ej: 15000" min="0" step="500" />
            </div>

            <div class="form-group">
              <label for="formMoneda">Moneda</label>
              <select id="formMoneda" class="form-select">
                <option value="ARS">ARS ($)</option>
                <option value="USD">USD (U$D)</option>
              </select>
            </div>

            <div class="form-group full">
              <label for="formNotas">Notas internas / Comentarios</label>
              <textarea
                id="formNotas"
                class="form-textarea"
                rows="2"
                placeholder="Ej: Prefiere novedades por WhatsApp los primeros días del mes."
              ></textarea>
            </div>
          </div>

          <div class="form-actions">
            <button type="button" id="btnModalCancel" class="btn-secondary">Cancelar</button>
            <button type="submit" id="btnModalSave" class="btn-primary">Guardar Padrinazgo</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal Formulario Caballo (Alta / Edición) -->
    <div id="horseModal" class="modal-overlay">
      <div class="modal-window">
        <div class="modal-header">
          <h2 id="horseModalTitle">Nuevo Caballo</h2>
          <button type="button" id="btnHorseModalClose" class="modal-close-btn">&times;</button>
        </div>

        <form id="horseForm">
          <input type="hidden" id="formHorseId" value="" />

          <div class="form-grid">
            <div class="form-group full">
              <label for="formHorseNombre">Nombre del Caballo *</label>
              <input type="text" id="formHorseNombre" class="form-input" required placeholder="Ej: Rayo, Pampa, Luna..." />
            </div>

            <div class="form-group full">
              <label>Foto del Caballo</label>
              <div class="image-upload-wrapper">
                <input type="file" id="formHorseFileInput" accept="image/*" class="file-hidden-input" />
                <input type="hidden" id="formHorseFoto" value="/placeholders/horse-01.svg" />

                <div id="imagePreviewBox" class="image-preview-box">
                  <img id="imagePreviewImg" src="" alt="Vista previa del caballo" style="display: none;" />
                  <div id="imageUploadPlaceholder" class="upload-placeholder-content">
                    <span style="font-size: 2.2rem;">📸</span>
                    <span>Subir foto desde tu dispositivo</span>
                    <span>Hacé clic acá para elegir una foto de tu compu o celular</span>
                  </div>
                </div>
                <div id="uploadStatusText" class="upload-status-hint" style="display: none;"></div>
              </div>
            </div>

            <div class="form-group">
              <label for="formHorseManada">Manada a la que pertenece</label>
              <select id="formHorseManada" class="form-select">
                <option value="">Sin manada asignada</option>
              </select>
            </div>

            <div class="form-group">
              <label for="formHorseEstado">Estado para Apadrinar</label>
              <select id="formHorseEstado" class="form-select">
                <option value="disponible">Disponible</option>
                <option value="pausado">Pausado</option>
                <option value="oculto">Oculto</option>
              </select>
            </div>

            <div class="form-group full">
              <label for="formHorseDescripcion">Historia o Descripción Corta</label>
              <textarea
                id="formHorseDescripcion"
                class="form-textarea"
                rows="3"
                placeholder="Contá brevemente su historia, rescate o personalidad en el santuario..."
              ></textarea>
            </div>
          </div>

          <div class="form-actions">
            <button type="button" id="btnHorseModalCancel" class="btn-secondary">Cancelar</button>
            <button type="submit" id="btnHorseModalSave" class="btn-primary">Guardar Caballo</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal Formulario Manada (Crear / Editar Grupo) -->
    <div id="manadaModal" class="modal-overlay">
      <div class="modal-window" style="max-width: 460px;">
        <div class="modal-header">
          <h2 id="manadaModalTitle">Nueva Manada</h2>
          <button type="button" id="btnManadaModalClose" class="modal-close-btn">&times;</button>
        </div>

        <form id="manadaForm">
          <input type="hidden" id="formManadaId" value="" />

          <div class="form-grid">
            <div class="form-group full">
              <label for="formManadaNombre">Nombre de la Manada *</label>
              <input type="text" id="formManadaNombre" class="form-input" required placeholder="Ej: Manada Principal, Los Abuelitos..." />
            </div>

            <div class="form-group full">
              <label for="formManadaColor">Color identificador</label>
              <div style="display: flex; gap: 0.75rem; align-items: center;">
                <input type="color" id="formManadaColor" value="#244137" style="width: 48px; height: 38px; border: none; border-radius: 8px; cursor: pointer;" />
                <span style="font-size: 0.85rem; color: var(--muted);">Color para identificarla visualmente</span>
              </div>
            </div>

            <div class="form-group full">
              <label for="formManadaDescripcion">Descripción / Ubicación (Opcional)</label>
              <textarea id="formManadaDescripcion" class="form-textarea" rows="2" placeholder="Ej: Paddock norte, caballos con necesidades de pastura suave..."></textarea>
            </div>
          </div>

          <div class="form-actions">
            <button type="button" id="btnManadaModalCancel" class="btn-secondary">Cancelar</button>
            <button type="submit" id="btnManadaModalSave" class="btn-primary">Guardar Manada</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Notificación Toast -->
    <div id="toast" class="toast-notice">
      <span id="toastIcon">✓</span>
      <span id="toastMessage">Guardado con éxito</span>
    </div>

    <!-- Script de lógica de la aplicación -->
    <script>
      import { supabase, isSupabaseConfigured } from '@/lib/supabase';
      import type { Sponsor, MonthlyReportRecord, HorseRecord, ManadaRecord } from '@/lib/types';
      import { MONTH_NAMES } from '@/lib/types';

      const bodyEl = document.body;
      const config = {
        adminPin: bodyEl.dataset.adminPin || '',
        currentYear: Number(bodyEl.dataset.currentYear) || new Date().getFullYear(),
        currentMonth: Number(bodyEl.dataset.currentMonth) || new Date().getMonth() + 1,
      };

      // Estado de la aplicación
      let activeYear = config.currentYear;
      let sponsors: Sponsor[] = [];
      let horsesList: HorseRecord[] = [];
      let manadasList: ManadaRecord[] = [];
      let reports: MonthlyReportRecord[] = [];
      let isLiveDb = isSupabaseConfigured;

      // Estado del selector de caballos en el modal de Padrino
      let selectedHorseIds: Set<string> = new Set();

      // Elementos del DOM
      const lockScreen = document.getElementById('lockScreen')!;
      const adminApp = document.getElementById('adminApp')!;
      const pinForm = document.getElementById('pinForm')!;
      const pinInput = document.getElementById('pinInput') as HTMLInputElement;
      const pinError = document.getElementById('pinError')!;
      const dbStatusPill = document.getElementById('dbStatusPill')!;
      const dbStatusText = document.getElementById('dbStatusText')!;

      // Pestañas
      const tabBtnSponsors = document.getElementById('tabBtnSponsors')!;
      const tabBtnHorses = document.getElementById('tabBtnHorses')!;
      const viewSponsors = document.getElementById('viewSponsors')!;
      const viewHorses = document.getElementById('viewHorses')!;
      const tabBadgeSponsors = document.getElementById('tabBadgeSponsors')!;
      const tabBadgeHorses = document.getElementById('tabBadgeHorses')!;
      const yearSelectorGroup = document.getElementById('yearSelectorGroup')!;

      // Subnavegación de caballos y manadas
      const subnavBtnManadas = document.getElementById('subnavBtnManadas')!;
      const subnavBtnAllHorses = document.getElementById('subnavBtnAllHorses')!;
      const manadasBoardView = document.getElementById('manadasBoardView')!;
      const allHorsesView = document.getElementById('allHorsesView')!;
      const manadasBoardContainer = document.getElementById('manadasBoardContainer')!;
      const totalHorsesBadge = document.getElementById('totalHorsesBadge')!;

      // Padrinos DOM
      const sponsorsTableBody = document.getElementById('sponsorsTableBody')!;
      const emptyState = document.getElementById('emptyState')!;
      const searchInput = document.getElementById('searchInput') as HTMLInputElement;
      const filterHorse = document.getElementById('filterHorse') as HTMLSelectElement;
      const filterManada = document.getElementById('filterManada') as HTMLSelectElement;
      const filterStatus = document.getElementById('filterStatus') as HTMLSelectElement;
      const currentMonthNameLabel = document.getElementById('currentMonthNameLabel')!;
      const toastEl = document.getElementById('toast')!;
      const toastMessage = document.getElementById('toastMessage')!;

      // Caballos DOM
      const horsesGridContainer = document.getElementById('horsesGridContainer')!;
      const horsesEmptyState = document.getElementById('horsesEmptyState')!;
      const searchHorsesInput = document.getElementById('searchHorsesInput') as HTMLInputElement;
      const filterHorseStatus = document.getElementById('filterHorseStatus') as HTMLSelectElement;
      const filterHorseManadaSelect = document.getElementById('filterHorseManadaSelect') as HTMLSelectElement;

      // Modales
      const sponsorModal = document.getElementById('sponsorModal')!;
      const sponsorForm = document.getElementById('sponsorForm') as HTMLFormElement;
      const modalTitle = document.getElementById('modalTitle')!;
      const btnModalClose = document.getElementById('btnModalClose')!;
      const btnModalCancel = document.getElementById('btnModalCancel')!;
      const btnOpenAddModal = document.getElementById('btnOpenAddModal')!;

      // Horse Picker DOM
      const pickerHorseSearch = document.getElementById('pickerHorseSearch') as HTMLInputElement;
      const pickerSelectedSummary = document.getElementById('pickerSelectedSummary')!;
      const pickerHorsesList = document.getElementById('pickerHorsesList')!;

      // Modal Caballo
      const horseModal = document.getElementById('horseModal')!;
      const horseForm = document.getElementById('horseForm') as HTMLFormElement;
      const horseModalTitle = document.getElementById('horseModalTitle')!;
      const btnHorseModalClose = document.getElementById('btnHorseModalClose')!;
      const btnHorseModalCancel = document.getElementById('btnHorseModalCancel')!;
      const btnOpenAddHorseModal = document.getElementById('btnOpenAddHorseModal')!;
      const btnQuickAddHorse = document.getElementById('btnQuickAddHorse')!;
      const btnHorseModalSave = document.getElementById('btnHorseModalSave') as HTMLButtonElement;
      const formHorseManada = document.getElementById('formHorseManada') as HTMLSelectElement;

      // Elementos de subida de imagen
      const formHorseFileInput = document.getElementById('formHorseFileInput') as HTMLInputElement;
      const formHorseFoto = document.getElementById('formHorseFoto') as HTMLInputElement;
      const imagePreviewBox = document.getElementById('imagePreviewBox')!;
      const imagePreviewImg = document.getElementById('imagePreviewImg') as HTMLImageElement;
      const imageUploadPlaceholder = document.getElementById('imageUploadPlaceholder')!;
      const uploadStatusText = document.getElementById('uploadStatusText')!;
      let selectedHorseFile: File | null = null;

      // Modal Manada
      const manadaModal = document.getElementById('manadaModal')!;
      const manadaForm = document.getElementById('manadaForm') as HTMLFormElement;
      const manadaModalTitle = document.getElementById('manadaModalTitle')!;
      const btnManadaModalClose = document.getElementById('btnManadaModalClose')!;
      const btnManadaModalCancel = document.getElementById('btnManadaModalCancel')!;
      const btnOpenAddManadaModal = document.getElementById('btnOpenAddManadaModal')!;

      const btnLogout = document.getElementById('btnLogout')!;
      const btnExportCsv = document.getElementById('btnExportCsv')!;

      // Inicialización de autenticación por PIN
      function initAuth() {
        const pin = config.adminPin;
        const isAuth = sessionStorage.getItem('almas_admin_auth') === 'true';

        if (!pin || isAuth) {
          showApp();
        } else {
          lockScreen.style.display = 'flex';
          adminApp.style.display = 'none';
        }
      }

      function showApp() {
        lockScreen.style.display = 'none';
        adminApp.style.display = 'block';
        initApp();
      }

      pinForm.addEventListener('submit', (e) => {
        e.preventDefault();
        if (pinInput.value.trim() === config.adminPin) {
          sessionStorage.setItem('almas_admin_auth', 'true');
          pinError.style.display = 'none';
          showApp();
        } else {
          pinError.style.display = 'block';
          pinInput.value = '';
          pinInput.focus();
        }
      });

      btnLogout.addEventListener('click', () => {
        sessionStorage.removeItem('almas_admin_auth');
        window.location.reload();
      });

      // Cambio de pestañas principales (Padrinos vs Caballos)
      function switchTab(tab: 'sponsors' | 'horses') {
        if (tab === 'sponsors') {
          tabBtnSponsors.classList.add('active');
          tabBtnHorses.classList.remove('active');
          viewSponsors.style.display = 'block';
          viewHorses.style.display = 'none';
          yearSelectorGroup.style.display = 'flex';
          btnExportCsv.style.display = 'inline-flex';
        } else {
          tabBtnSponsors.classList.remove('active');
          tabBtnHorses.classList.add('active');
          viewSponsors.style.display = 'none';
          viewHorses.style.display = 'block';
          yearSelectorGroup.style.display = 'none';
          btnExportCsv.style.display = 'none';
          renderManadasBoard();
          renderHorsesGrid();
        }
      }

      // Cambio de sub-vista en Caballos (Manadas vs Todos)
      function switchHorsesSubView(mode: 'manadas' | 'all') {
        if (mode === 'manadas') {
          subnavBtnManadas.classList.add('active');
          subnavBtnAllHorses.classList.remove('active');
          manadasBoardView.style.display = 'block';
          allHorsesView.style.display = 'none';
          renderManadasBoard();
        } else {
          subnavBtnManadas.classList.remove('active');
          subnavBtnAllHorses.classList.add('active');
          manadasBoardView.style.display = 'none';
          allHorsesView.style.display = 'block';
          renderHorsesGrid();
        }
      }

      // Inicialización de la Aplicación
      async function initApp() {
        updateDbStatus();
        highlightCurrentMonthHeaders();
        setupYearSelector();
        setupEventListeners();

        // Carga secuencial protegida con try/catch independiente para evitar bloqueos en cascada
        try {
          await loadManadasData();
        } catch (err) {
          console.warn('[AlmasLibres] Error al cargar manadas:', err);
        }

        try {
          await loadHorsesData();
        } catch (err) {
          console.warn('[AlmasLibres] Error al cargar caballos:', err);
        }

        try {
          await loadSponsorsData();
        } catch (err) {
          console.warn('[AlmasLibres] Error al cargar padrinos:', err);
        }
      }

      function updateDbStatus() {
        if (isLiveDb) {
          dbStatusPill.style.display = 'inline-flex';
          dbStatusPill.className = 'status-pill live';
          dbStatusText.textContent = 'En línea';
        } else {
          dbStatusPill.style.display = 'none';
        }
      }

      function highlightCurrentMonthHeaders() {
        const monthNum = config.currentMonth;
        currentMonthNameLabel.textContent = MONTH_NAMES[monthNum - 1];

        document.querySelectorAll('.th-month').forEach((th) => {
          const m = Number(th.getAttribute('data-month'));
          if (m === monthNum && activeYear === config.currentYear) {
            th.classList.add('current-month');
          } else {
            th.classList.remove('current-month');
          }
        });
      }

      function setupYearSelector() {
        document.querySelectorAll('.year-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.year-btn').forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            activeYear = Number(btn.getAttribute('data-year'));
            highlightCurrentMonthHeaders();
            loadReportsForYear(activeYear);
          });
        });
      }

      // ==========================================
      // GESTIÓN DE MANADAS (GRUPOS DE CABALLOS)
      // ==========================================
      const DEFAULT_MANADAS: ManadaRecord[] = [
        { id: 'manada-principal', nombre: 'Manada Principal', color: '#244137', descripcion: 'Manada mayor en pasturas abiertas.' },
        { id: 'manada-abuelos', nombre: 'Manada de los Abuelos', color: '#b96e46', descripcion: 'Caballos mayores con atención especial.' },
        { id: 'manada-paddock-bajo', nombre: 'Manada del Paddock Bajo', color: '#2b8a3e', descripcion: 'Sector bajo con sombra y arboleda.' },
      ];

      async function loadManadasData() {
        let loadedManadas: ManadaRecord[] = [];
        const local = localStorage.getItem('almas_manadas');
        const localManadas = local ? JSON.parse(local) : DEFAULT_MANADAS;

        if (isLiveDb && supabase) {
          try {
            const { data, error } = await supabase
              .from('manadas')
              .select('*')
              .order('nombre', { ascending: true });

            if (!error && data && data.length > 0) {
              loadedManadas = data;
            } else {
              loadedManadas = localManadas;
            }
          } catch {
            loadedManadas = localManadas;
          }
        } else {
          loadedManadas = localManadas;
        }

        manadasList = loadedManadas;
        saveLocalManadas();
        updateManadaSelectDropdowns();
      }

      function saveLocalManadas() {
        localStorage.setItem('almas_manadas', JSON.stringify(manadasList));
      }

      function updateManadaSelectDropdowns() {
        // Dropdown en el filtro de la tabla de padrinos
        const curFilterManada = filterManada.value;
        filterManada.innerHTML = '<option value="all">Todas las manadas</option><option value="none">Sin manada</option>';
        manadasList.forEach((m) => {
          const opt = document.createElement('option');
          opt.value = m.id;
          opt.textContent = m.nombre;
          filterManada.appendChild(opt);
        });
        filterManada.value = curFilterManada || 'all';

        // Dropdown en el filtro de la lista de caballos
        const curFilterHorseManada = filterHorseManadaSelect.value;
        filterHorseManadaSelect.innerHTML = '<option value="all">Todas las manadas</option><option value="none">Sin manada</option>';
        manadasList.forEach((m) => {
          const opt = document.createElement('option');
          opt.value = m.id;
          opt.textContent = m.nombre;
          filterHorseManadaSelect.appendChild(opt);
        });
        filterHorseManadaSelect.value = curFilterHorseManada || 'all';

        // Dropdown en el modal de caballo
        const curFormManada = formHorseManada.value;
        formHorseManada.innerHTML = '<option value="">Sin manada asignada</option>';
        manadasList.forEach((m) => {
          const opt = document.createElement('option');
          opt.value = m.id;
          opt.setAttribute('data-name', m.nombre);
          opt.textContent = m.nombre;
          formHorseManada.appendChild(opt);
        });
        formHorseManada.value = curFormManada || '';
      }

      // Modal Manada
      function openAddManadaModal() {
        (document.getElementById('formManadaId') as HTMLInputElement).value = '';
        manadaForm.reset();
        (document.getElementById('formManadaColor') as HTMLInputElement).value = '#244137';
        manadaModalTitle.textContent = 'Nueva Manada';
        manadaModal.classList.add('open');
      }

      function openEditManadaModal(id: string) {
        const m = manadasList.find((manada) => manada.id === id);
        if (!m) return;

        (document.getElementById('formManadaId') as HTMLInputElement).value = m.id;
        (document.getElementById('formManadaNombre') as HTMLInputElement).value = m.nombre;
        (document.getElementById('formManadaColor') as HTMLInputElement).value = m.color || '#244137';
        (document.getElementById('formManadaDescripcion') as HTMLTextAreaElement).value = m.descripcion || '';

        manadaModalTitle.textContent = 'Editar Manada';
        manadaModal.classList.add('open');
      }

      function closeManadaModal() {
        manadaModal.classList.remove('open');
      }

      manadaForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const id = (document.getElementById('formManadaId') as HTMLInputElement).value;
        const nombre = (document.getElementById('formManadaNombre') as HTMLInputElement).value.trim();
        const color = (document.getElementById('formManadaColor') as HTMLInputElement).value;
        const descripcion = (document.getElementById('formManadaDescripcion') as HTMLTextAreaElement).value.trim() || undefined;

        const payload: Partial<ManadaRecord> = { nombre, color, descripcion };

        if (id) {
          // Edición
          if (isLiveDb && supabase) {
            const { error } = await supabase.from('manadas').update(payload).eq('id', id);
            if (error) {
              console.error(error);
              showToast('Error al actualizar manada en Supabase', true);
              return;
            }
          }
          const idx = manadasList.findIndex((m) => m.id === id);
          if (idx !== -1) manadasList[idx] = { ...manadasList[idx], ...payload };
          showToast('Manada actualizada');
        } else {
          // Alta
          const newId = isLiveDb ? undefined : `local-manada-${Date.now()}`;
          if (isLiveDb && supabase) {
            const { data, error } = await supabase.from('manadas').insert([payload]).select().single();
            if (error) {
              console.error(error);
              showToast('Error al guardar manada en Supabase', true);
              return;
            }
            if (data) manadasList.push(data);
          } else {
            const newManada = { ...payload, id: newId!, created_at: new Date().toISOString() } as ManadaRecord;
            manadasList.push(newManada);
          }
          showToast('Nueva manada creada');
        }

        if (!isLiveDb) saveLocalManadas();

        closeManadaModal();
        updateManadaSelectDropdowns();
        renderManadasBoard();
        renderHorsesGrid();
      });

      async function deleteManada(id: string) {
        const m = manadasList.find((manada) => manada.id === id);
        if (!m) return;

        const horsesInManada = horsesList.filter((h) => h.manada_id === id);
        if (horsesInManada.length > 0) {
          alert(`No se puede eliminar la manada "${m.nombre}" porque tiene ${horsesInManada.length} caballo(s) asignado(s). Primero movelos a otra manada.`);
          return;
        }

        if (!confirm(`¿Eliminar la manada "${m.nombre}"?`)) return;

        if (isLiveDb && supabase) {
          const { error } = await supabase.from('manadas').delete().eq('id', id);
          if (error) {
            console.error(error);
            showToast('Error al eliminar en Supabase', true);
            return;
          }
        }

        manadasList = manadasList.filter((manada) => manada.id !== id);
        if (!isLiveDb) saveLocalManadas();

        updateManadaSelectDropdowns();
        renderManadasBoard();
        renderHorsesGrid();
        showToast('Manada eliminada');
      }

      // Mover caballo a otra manada de forma rápida
      async function quickMoveHorseManada(horseId: string, newManadaId: string) {
        const horse = horsesList.find((h) => h.id === horseId);
        if (!horse) return;

        const targetManada = manadasList.find((m) => m.id === newManadaId);
        const manada_id = newManadaId || null;
        const manada_nombre = targetManada ? targetManada.nombre : null;

        if (isLiveDb && supabase) {
          try {
            const { error } = await supabase
              .from('caballos')
              .update({ manada_id, manada_nombre })
              .eq('id', horseId);
            if (error) throw error;
          } catch (err) {
            console.error('Error reasignando manada:', err);
            showToast('Error de sincronización al mover de manada', true);
            return;
          }
        }

        horse.manada_id = manada_id || undefined;
        horse.manada_nombre = manada_nombre || undefined;
        if (!isLiveDb) saveLocalHorses();

        renderManadasBoard();
        renderHorsesGrid();
        showToast(`${horse.nombre} reasignado a ${targetManada ? targetManada.nombre : 'Sin manada'}`);
      }

      // Render del Tablero Visual de Manadas
      function renderManadasBoard() {
        const columnsData: Array<{ id: string; nombre: string; color: string; descripcion?: string; horses: HorseRecord[] }> = [
          ...manadasList.map((m) => ({
            id: m.id,
            nombre: m.nombre,
            color: m.color || '#244137',
            descripcion: m.descripcion,
            horses: horsesList.filter((h) => h.manada_id === m.id),
          })),
          {
            id: 'unassigned',
            nombre: 'Sin Manada Asignada',
            color: '#868e96',
            descripcion: 'Caballos pendientes de agrupar.',
            horses: horsesList.filter((h) => !h.manada_id),
          },
        ];

        manadasBoardContainer.innerHTML = columnsData
          .map((col) => {
            const isUnassigned = col.id === 'unassigned';
            const horsesCards = col.horses
              .map((horse) => {
                const activeSponsorsCount = sponsors.filter(
                  (s) => s.caballo_id === horse.id && s.estado === 'activo'
                ).length;

                // Opciones del selector de movimiento rápido
                const moveOptions = [
                  `<option value="">Sin manada</option>`,
                  ...manadasList.map(
                    (m) => `<option value="${m.id}" ${m.id === horse.manada_id ? 'selected' : ''}>${escapeHtml(m.nombre)}</option>`
                  ),
                ].join('');

                return `
                  <article class="manada-horse-card" data-horse-id="${horse.id}">
                    <div class="manada-horse-header">
                      <img
                        src="${horse.foto || '/placeholders/horse-01.svg'}"
                        alt="${escapeHtml(horse.nombre)}"
                        class="manada-horse-thumb"
                        onerror="this.src='/placeholders/horse-01.svg'"
                      />
                      <div style="flex: 1; min-width: 0;">
                        <h4 class="manada-horse-name">${escapeHtml(horse.nombre)}</h4>
                        <span class="status-tag ${horse.estado}" style="font-size: 0.68rem; padding: 0.1rem 0.4rem;">${horse.estado}</span>
                      </div>
                      <div class="row-actions">
                        <button type="button" class="btn-icon btn-edit-horse" data-id="${horse.id}" title="Editar caballo">✏️</button>
                      </div>
                    </div>

                    <div class="manada-horse-footer">
                      <span class="sponsor-count-pill ${activeSponsorsCount === 0 ? 'empty' : ''}" style="font-size: 0.72rem; padding: 0.15rem 0.5rem;">
                        👥 ${activeSponsorsCount}
                      </span>

                      <div style="display: flex; align-items: center; gap: 0.25rem;">
                        <span style="font-size: 0.72rem; color: var(--muted);">Mover:</span>
                        <select class="move-manada-select" data-horse-id="${horse.id}">
                          ${moveOptions}
                        </select>
                      </div>
                    </div>
                  </article>
                `;
              })
              .join('');

            return `
              <div class="manada-column" style="border-top: 4px solid ${col.color};">
                <div class="manada-column-header">
                  <div class="manada-header-info">
                    <span class="manada-color-dot" style="background: ${col.color};"></span>
                    <h3 class="manada-column-title">${escapeHtml(col.nombre)}</h3>
                    <span class="manada-column-badge">${col.horses.length}</span>
                  </div>

                  ${
                    !isUnassigned
                      ? `
                        <div class="row-actions">
                          <button type="button" class="btn-icon btn-edit-manada" data-id="${col.id}" title="Editar manada">✏️</button>
                          <button type="button" class="btn-icon delete btn-delete-manada" data-id="${col.id}" title="Eliminar manada">🗑️</button>
                        </div>
                      `
                      : ''
                  }
                </div>

                <div class="manada-column-body">
                  ${
                    col.horses.length > 0
                      ? horsesCards
                      : `<div style="text-align: center; color: var(--muted); font-size: 0.8rem; padding: 1.5rem 0.5rem; font-style: italic;">No hay caballos en este grupo.</div>`
                  }
                </div>
              </div>
            `;
          })
          .join('');

        // Listeners en el tablero de manadas
        document.querySelectorAll('.move-manada-select').forEach((sel) => {
          sel.addEventListener('change', (e) => {
            const selectEl = e.currentTarget as HTMLSelectElement;
            const horseId = selectEl.getAttribute('data-horse-id')!;
            quickMoveHorseManada(horseId, selectEl.value);
          });
        });

        document.querySelectorAll('.btn-edit-manada').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLElement).getAttribute('data-id')!;
            openEditManadaModal(id);
          });
        });

        document.querySelectorAll('.btn-delete-manada').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLElement).getAttribute('data-id')!;
            deleteManada(id);
          });
        });

        document.querySelectorAll('.btn-edit-horse').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLElement).getAttribute('data-id')!;
            openEditHorseModal(id);
          });
        });
      }

